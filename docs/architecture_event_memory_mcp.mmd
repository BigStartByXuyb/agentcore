%% ============================================================
%% My-Agent 事件系统 + 记忆系统 + MCP 系统
%% ============================================================

%% --- 事件类型层级 ---
graph TB
    subgraph EVENT_SYS["事件系统 events.py"]
        direction TB
        AE["AgentEvent(label)"]
        AE --> TD["TextDelta<br/>delta, first"]
        AE --> TB2["TextBlock<br/>text"]
        AE --> TH["ThinkingBlock<br/>thinking"]
        AE --> TS["ToolStart<br/>tool_name, tool_input"]
        AE --> TE["ToolEnd<br/>tool_name, is_error, summary"]
        AE --> EE["ErrorEvent<br/>error_text"]
        AE --> RC["Recovery<br/>message"]
        AE --> TU["TokenUsage<br/>input/output/thinking tokens"]
        AE --> RN["RetryNotice<br/>delay, attempt, max"]
    end

    subgraph EVENT_FLOW["事件流向"]
        direction LR
        SRC["run_agent_loop<br/>(generator)"]
        SRC -->|"yield"| MID["tool_runner<br/>yield from"]
        MID -->|"yield from"| CHILD["子 agent/fork<br/>yield from"]
        SRC -->|最终消费| CONS["consume_events()<br/>→ display.py"]
    end

    subgraph MEMORY_SYS["记忆系统 memory/"]
        direction TB
        MP["paths.py<br/>~/.my-agent/memory/<br/>&lt;project&gt;/memory/"]
        MS["scan.py<br/>扫描 *.md 文件<br/>解析 frontmatter"]
        MPR["prompt.py<br/>构建行为指令<br/>告诉 LLM 如何读写记忆"]
        MR["recall.py<br/>side_query 选择<br/>相关记忆"]
        ME["extract.py<br/>后台记忆提取<br/>(forked agent)"]

        MP --> MS
        MS --> MR
        MPR -->|注入 system_prompt| SP["system_prompt.py"]
        MR -->|注入 user msg| AL2["agent_loop"]
        ME -->|后台运行| AL2
    end

    subgraph MCP_SYS["MCP 系统 mcp_tool/"]
        direction TB
        MCFG["config.py<br/>加载 mcp.json"]
        MCFG -->|全局| G_CFG["~/.my-agent/mcp.json"]
        MCFG -->|项目| P_CFG["&lt;cwd&gt;/.mcp.json"]

        MBASE["base.py<br/>McpClientBase (ABC)"]
        MHTTP["McpHttpClient<br/>HTTP/SSE 传输"]
        MPIPE["McpPipelineClient<br/>Stdio 管道传输"]
        MHTTP -.->|extends| MBASE
        MPIPE -.->|extends| MBASE

        MINIT["__init__.py<br/>McpServer dataclass"]
        MINIT -->|discover| MCFG
        MINIT -->|connect| MBASE
        MINIT -->|register| REG["ALL_TOOLS<br/>(动态注册远程工具)"]

        MBASE -->|list_tools| REMOTE["远程 MCP Server"]
        MBASE -->|call_tool| REMOTE
    end

    classDef event fill:#673AB7,color:#fff
    classDef flow fill:#FF9800,color:#fff
    classDef mem fill:#E91E63,color:#fff
    classDef mcp fill:#00BCD4,color:#fff

    class AE,TD,TB2,TH,TS,TE,EE,RC,TU,RN event
    class SRC,MID,CHILD,CONS flow
    class MP,MS,MPR,MR,ME mem
    class MCFG,G_CFG,P_CFG,MBASE,MHTTP,MPIPE,MINIT,REG,REMOTE mcp
